# ==============================================================================
# Antigravity Career Hub - Environment Variables Template
# Copy this file to .env and populate with local development values.
# NEVER commit .env or real secret keys to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL instance
DATABASE_URL=postgres://postgres:postgres@localhost:5432/career_hub_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. Redis / Cache Configuration (Optional for local dev, fallback to in-memory)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Master Keys
# ------------------------------------------------------------------------------
# Master symmetric encryption key for AES-256-GCM (MUST be exactly 32 bytes / 64 hex characters)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=v1

# Secret for signing web session cookies and state parameters
AUTH_SECRET=super_secret_session_signing_key_change_me_in_production_32chars

# Secret for signing and hashing internal MCP Bearer tokens
MCP_TOKEN_SECRET=super_secret_mcp_token_signing_key_change_me_in_production

# ------------------------------------------------------------------------------
# 5. GitHub OAuth & App Integration Configuration
# ------------------------------------------------------------------------------
# GitHub OAuth 2.0 Client ID & Secret for user authentication (Login with GitHub)
GITHUB_CLIENT_ID=placeholder_github_oauth_client_id
GITHUB_CLIENT_SECRET=placeholder_github_oauth_client_secret
# Local Development: http://localhost:3000/auth/github/callback
# Staging: https://staging.aicareershub.tech/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Session Cookie Configuration
SESSION_COOKIE_NAME=career_hub_session
SESSION_TTL_SECONDS=604800
# Local Development: http://localhost:3000 | Staging: https://staging.aicareershub.tech
APP_URL=http://localhost:3000
# OAuth 2.1 Metadata Discovery URLs (defaults to APP_URL if unset)
# OAUTH_ISSUER_URL=https://staging.aicareershub.tech
# OAUTH_RESOURCE_URL=https://staging.aicareershub.tech/mcp

# Registered GitHub App ID & Slug (for repository connector in Phase 3)
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=antigravity-career-hub
GITHUB_APP_CLIENT_ID=Iv1.placeholder_client_id
GITHUB_APP_CLIENT_SECRET=placeholder_github_app_client_secret

# Webhook Secret configured in GitHub App settings for HMAC signature verification
GITHUB_WEBHOOK_SECRET=placeholder_webhook_secret_hmac_sha256

# GitHub App RSA Private Key (PEM format, raw multiline or base64-encoded)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...[BASE64_PEM_PLACEHOLDER]...==\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQpwbGFjZWhvbGRlcg==

# ------------------------------------------------------------------------------
# 6. AI Client & Integration Testing
# ------------------------------------------------------------------------------
# Google Gemini Developer API Key (Used strictly for automated integration test execution)
GEMINI_API_KEY=AIzaSy_placeholder_gemini_api_key

# Public/Base URL exposed for remote MCP clients (Gemini, Claude, ChatGPT)
# Local Development: http://localhost:3000/mcp | Staging: https://staging.aicareershub.tech/mcp
MCP_BASE_URL=http://localhost:3000/mcp

# ------------------------------------------------------------------------------
# 7. Logging & Telemetry
# ------------------------------------------------------------------------------
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
