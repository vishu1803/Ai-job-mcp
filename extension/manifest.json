{
  "manifest_version": 3,
  "name": "aicareershub",
  "version": "1.0.0",
  "description": "Official AI Careers Hub thin-client extension for job detection, ATS fit analysis, and Handoff Kit preparation.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "aicareershub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.aicareershub.tech/*",
    "https://aicareershub.tech/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "job-detection/*",
        "popup/*",
        "icons/*",
        "content/*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "key": ""
}