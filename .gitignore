# ==============================================================================
# Git Ignore Configuration - Antigravity Career Hub
# ==============================================================================

# Environment and Secrets (CRITICAL: Never commit secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
.env.local
# Credentials & Key Files
*.pem
*.key
*.cert
*.crt
id_rsa
id_ecdsa

# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Compilation Artifacts
dist/
build/
out/
.next/
.turbo/

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
test-results/

# Log Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases and Local Storage
*.sqlite
*.sqlite3
*.db
*.db-journal
postgres-data/
redis-data/

# OS and Editor Specific Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Temporary & Scratch Files
tmp/
temp/
scratch/
*.tmp
*.bak

# Internal Project & AI Control Documents (Only README.md is tracked in Git)
AGENTS.md
project.md
goal.md
road.md
roadmap.md

# Document Storage & Upload Blobs
storage/
!storage/.gitkeep
